# Supabase (Project Settings > API Keys, onglet "Publishable and secret API keys")
NEXT_PUBLIC_SUPABASE_URL=                 # https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # clé publique, commence par sb_publishable (ou l'ancienne clé anon)
SUPABASE_SECRET_KEY=                      # clé secrète, commence par sb_secret ; serveur uniquement

# Anthropic (console.anthropic.com > API keys) : lecture des captures et reçus
ANTHROPIC_API_KEY=                        # commence par sk-ant
CLAUDE_MODEL=claude-sonnet-5

# WhatsApp (Meta Cloud API) : developers.facebook.com > votre app > WhatsApp > API Setup
WHATSAPP_TOKEN=                           # jeton System User permanent (ou temporaire 24 h pour tester)
WHATSAPP_PHONE_NUMBER_ID=                 # "Phone number ID" du numéro de test
WHATSAPP_VERIFY_TOKEN=                    # chaîne de votre choix, à recopier dans la config du webhook
WHATSAPP_APP_SECRET=                      # facultatif : App settings > Basic > App secret (vérifie les signatures)
NEXT_PUBLIC_WHATSAPP_NUMBER=              # numéro affiché dans Réglages, ex. +1 555 123 4567
NEXT_PUBLIC_SITE_URL=https://sama-depenses.netlify.app
